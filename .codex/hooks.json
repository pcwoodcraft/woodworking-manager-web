{
  "description": "Require a safe commit and task-branch push before a write task stops.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.agents/hooks/git-checkpoint.ps1\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.agents/hooks/git-checkpoint.ps1')\"",
            "timeout": 30,
            "statusMessage": "Kontrolujem Git checkpoint a push pracovnej vetvy"
          }
        ]
      }
    ]
  }
}
