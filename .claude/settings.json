{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.agents/hooks/git-checkpoint.ps1')\"",
            "timeout": 30,
            "statusMessage": "Kontrolujem Git checkpoint a push pracovnej vetvy"
          }
        ]
      }
    ]
  }
}
